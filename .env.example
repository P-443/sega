# ── Database (PostgreSQL) ──────────────────────────────────────────
# On Coolify: create a PostgreSQL service, then paste its internal URL here.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# ── Sessions ───────────────────────────────────────────────────────
# Random secret used to sign/hash session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── App ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public URL of the site (used for invite links / room sharing)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minutes a disconnected player can rejoin before the game is abandoned
DISCONNECT_GRACE_SECONDS=60
